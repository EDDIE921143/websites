{
  "name": "ediz-os",
  "private": true,
  "version": "0.3.31",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "ios:open": "open ios/App/App.xcodeproj",
    "native:test": "swift test --package-path native/Core",
    "ios:build": "xcodebuild -project ios/App/App.xcodeproj -scheme App -sdk iphonesimulator -destination \"generic/platform=iOS Simulator\" CODE_SIGNING_ALLOWED=NO build",
    "ios:install": "bash scripts/install-native-device.sh",
    "ios:health": "python3 scripts/native-health.py --app \"${EDIZ_BUILD_PATH:-.native-build}/Build/Products/Release-iphoneos/App.app\"",
    "check": "npm test && npm run native:test && python3 -m unittest discover -s scripts -p \"*_test.py\" && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.3.7",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.0",
    "vercel": "^62.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.0.0"
  }
}
